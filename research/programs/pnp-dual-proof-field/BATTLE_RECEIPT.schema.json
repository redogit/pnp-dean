{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "PNP Dual Proof Field Battle Receipt",
  "type": "object",
  "required": [
    "battle_id",
    "obligation",
    "claim",
    "cost",
    "referee",
    "status",
    "remainder"
  ],
  "properties": {
    "battle_id": { "type": "string" },
    "protocol": { "type": "string" },
    "source_revision": { "type": "string" },
    "obligation": { "type": "string" },
    "obligation_slice_refs": { "type": "array", "items": { "type": "string" } },
    "generator_requests": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["generator", "accepted_obligation", "requested_parts"],
        "properties": {
          "generator": { "type": "string" },
          "accepted_obligation": { "type": "string" },
          "request_ref": { "type": ["string", "null"] },
          "requested_parts": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "fixed_definitions": { "type": "array", "items": { "type": "string" } },
    "offense": { "type": ["object", "null"] },
    "defense": { "type": ["object", "null"] },
    "claim": {
      "type": "object",
      "required": ["statement", "scope"],
      "properties": {
        "statement": { "type": "string" },
        "scope": { "type": "string" },
        "claim_ceiling": { "type": "string" }
      }
    },
    "evidence": { "type": "array", "items": { "type": "string" } },
    "counterexample": { "type": ["string", "null"] },
    "cost": { "type": "object" },
    "referee": {
      "type": "object",
      "required": ["verdict"],
      "properties": {
        "verdict": {
          "enum": [
            "ADMIT_SCOPED",
            "REJECT_COUNTEREXAMPLE",
            "REPAIRABLE",
            "UNRESOLVED",
            "INVALID_ATTACK"
          ]
        },
        "reason": { "type": "string" },
        "audit_refs": { "type": "array", "items": { "type": "string" } }
      }
    },
    "status": {
      "enum": [
        "ACTIVE",
        "SURVIVES_SCOPED",
        "DEFEATED",
        "REPAIR_PENDING",
        "UNRESOLVED",
        "RETIRED_SUBSUMED"
      ]
    },
    "repair_of": { "type": ["string", "null"] },
    "preserved_distinctions": { "type": "array", "items": { "type": "string" } },
    "lost_or_unresolved_distinctions": { "type": "array", "items": { "type": "string" } },
    "recovery_reference": { "type": ["string", "null"] },
    "remainder": { "type": "string" }
  }
}
